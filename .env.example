# Copy to .env at repository root. No credentials belong in VITE_* variables.
API_PORT=3000
FE_PORT=5173
APP_ORIGIN=http://localhost:5173
# Required for saving/sharing. Create a separate local development DB first.
DATABASE_URL=
AI_PROVIDER=none
# Opt in with openai-compatible and your provider-supported model.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
INVITATION_LIMIT=20000
RATE_LIMIT=60
SESSION_HOURS=168
GRANT_HOURS=72
